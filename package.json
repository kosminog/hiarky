{
  "name": "hiarky",
  "version": "0.1.1",
  "description": "Snapshot what your project declares — components, routes, API procedures, database models, migrations, config — and review how it changes over time",
  "license": "MIT",
  "author": "Kosminog (https://github.com/kosminog)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosminog/hiarky.git"
  },
  "homepage": "https://github.com/kosminog/hiarky#readme",
  "bugs": {
    "url": "https://github.com/kosminog/hiarky/issues"
  },
  "type": "commonjs",
  "bin": {
    "hiarky": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "static-analysis",
    "code-review",
    "snapshot",
    "codebase",
    "diff",
    "cli",
    "react",
    "python",
    "prisma",
    "typescript"
  ],
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0",
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.6",
    "jsdom": "^30.1.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.1"
  }
}
